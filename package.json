{
  "name": "drift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "description": "Design system auditor for live websites",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "crawl": "tsx --tsconfig tsconfig.runtime.json src/index.ts",
    "capture": "tsx --tsconfig tsconfig.runtime.json src/capture.ts",
    "discover": "tsx --tsconfig tsconfig.runtime.json src/crawler/discoverDemo.ts",
    "dev:server": "tsx --tsconfig tsconfig.runtime.json src/server/index.ts",
    "queue:demo": "tsx --tsconfig tsconfig.runtime.json src/queue/demo.ts",
    "realtime:demo": "tsx --tsconfig tsconfig.runtime.json src/realtime/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bullmq": "^6.3.1",
    "express": "^5.2.1",
    "haus-colour-utils": "^0.3.0",
    "haus-style-probe": "^0.2.1",
    "ioredis": "^5.11.1",
    "playwright": "^1.62.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.16.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
