{
  "name": "drift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Design system auditor for live websites",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "crawl": "tsx --tsconfig tsconfig.runtime.json src/index.ts",
    "capture": "tsx --tsconfig tsconfig.runtime.json src/capture.ts",
    "discover": "tsx --tsconfig tsconfig.runtime.json src/crawler/discoverDemo.ts",
    "dev:server": "tsx --tsconfig tsconfig.runtime.json src/server/index.ts",
    "queue:demo": "tsx --tsconfig tsconfig.runtime.json src/queue/demo.ts",
    "realtime:demo": "tsx --tsconfig tsconfig.runtime.json src/realtime/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"client/src/**/*.css\" --report-needless-disables",
    "lint:css:fix": "stylelint \"client/src/**/*.css\" --fix",
    "lint:prose": "node scripts/check-punctuation.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:api": "redocly lint openapi.yaml",
    "lint:md": "markdownlint-cli2",
    "knip": "knip && knip --directory client"
  },
  "dependencies": {
    "bullmq": "^6.7.5",
    "express": "^5.3.0",
    "haus-colour-utils": "^1.0.0",
    "haus-style-probe": "^1.0.0",
    "ioredis": "^6.0.0",
    "playwright": "^1.65.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "2.72.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "6.44.1",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "^11.0.8"
    },
    "micromark-extension-math": {
      "katex": "^0.19.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
