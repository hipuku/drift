{
  "name": "drift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system auditor for live websites",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "crawl": "tsx --tsconfig tsconfig.runtime.json src/index.ts",
    "discover": "tsx --tsconfig tsconfig.runtime.json src/crawler/discoverDemo.ts",
    "dev:server": "tsx --tsconfig tsconfig.runtime.json src/server/index.ts",
    "queue:demo": "tsx --tsconfig tsconfig.runtime.json src/queue/demo.ts",
    "realtime:demo": "tsx --tsconfig tsconfig.runtime.json src/realtime/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bullmq": "^5.78.1",
    "chroma-js": "^3.2.0",
    "express": "^5.2.1",
    "haus-colour-utils": "^0.1.2",
    "haus-style-probe": "^0.2.1",
    "ioredis": "^5.11.1",
    "playwright": "^1.48.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chroma-js": "^3.1.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.16.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.8",
    "yaml": "^2.9.0"
  }
}
