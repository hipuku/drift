{
  "name": "drift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system auditor for live websites",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "crawl": "tsx --tsconfig tsconfig.runtime.json src/index.ts",
    "discover": "tsx --tsconfig tsconfig.runtime.json src/crawler/discoverDemo.ts",
    "queue:demo": "tsx --tsconfig tsconfig.runtime.json src/queue/demo.ts",
    "realtime:demo": "tsx --tsconfig tsconfig.runtime.json src/realtime/demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@haus/colour-utils": "file:../haus/packages/colour-utils",
    "bullmq": "^5.78.1",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "playwright": "^1.48.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.16.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  }
}
