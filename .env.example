# Redis connection for the BullMQ job queue.
# Defaults to redis://127.0.0.1:6379 when unset.
REDIS_URL=redis://127.0.0.1:6379

# Where the backend listens. 127.0.0.1 by default, so it is not on the network by
# accident. Set to 0.0.0.0 to expose it, and set DRIFT_API_TOKEN when you do.
HOST=127.0.0.1

# Optional. When set, every API route and the progress WebSocket need
# `Authorization: Bearer <token>`. Unset, the API is open.
DRIFT_API_TOKEN=

# Crawl and discover requests per caller per minute. Unset: 20 when HOST is
# beyond loopback, no limit on loopback. 0 turns the limit off.
DRIFT_RATE_LIMIT_PER_MINUTE=

# Crawls that may wait or run at once before a new one gets a 429. Default 20.
DRIFT_MAX_QUEUED=20

# Optional. When set, outgoing webhook bodies are signed with HMAC-SHA256 and
# sent as `x-drift-signature: sha256=…` so the receiver can verify them.
DRIFT_WEBHOOK_SECRET=

# Optional. Hosts the crawler may reach although they resolve to a private or
# local address, comma-separated. Empty by default, so a crawl can never read the
# server's own network. Set to `127.0.0.1` to crawl a site running on this machine:
# the API refuses a host with no dot, such as `localhost`, before this is read.
DRIFT_CRAWL_ALLOWED_HOSTS=

# Optional. The same exemption for webhook callback hosts.
DRIFT_WEBHOOK_ALLOWED_HOSTS=

# Client build only. When "true", the client replays the bundled audit instead
# of calling the backend. That is what the public deploy ships, since the crawler
# is a headless browser behind a queue and isn't left running on a public URL.
VITE_DEMO_MODE=false
