# Redis connection for the BullMQ job queue.
# Defaults to redis://127.0.0.1:6379 when unset.
REDIS_URL=redis://127.0.0.1:6379

# Optional. When set, outgoing webhook bodies are signed with HMAC-SHA256 and
# sent as `x-drift-signature: sha256=…` so the receiver can verify them.
DRIFT_WEBHOOK_SECRET=

# Client build only. When "true", the client replays the bundled audit instead
# of calling the backend. That is what the public deploy ships, since the crawler
# is a headless browser behind a queue and isn't left running on a public URL.
VITE_DEMO_MODE=false
